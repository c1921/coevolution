{
  "$schema": "../schema.json",
  "dslVersion": 1,
  "kind": "card",
  "id": "heavy-press",
  "priority": 100,
  "name": "重压",
  "short": "令对方获得 ⌊手牌数 / 2⌋ 点威胁（1~4）",
  "text": "消耗 2 点能量：令对方获得「自己手牌数的一半（向下取整）」点威胁，最少 1 点、最多 4 点。",
  "cost": { "kind": "const", "value": 2 },
  "rarity": "uncommon",
  "use": [
    {
      "context": "play",
      "target": { "scope": "opponent", "required": false, "alive": true, "range": true },
      "effects": [
        {
          "kind": "move-cards",
          "from": { "zone": "hand", "of": "self" },
          "to": { "zone": "discard", "of": "self" },
          "pick": { "mode": "played" }
        },
        { "kind": "record-card-use", "of": "self", "cardKind": "heavy-press" },
        { "kind": "log", "template": "{self} 对 {target} 使用{usedAs}{self.energyTag}" },
        {
          "kind": "threat",
          "target": "target",
          "amount": {
            "kind": "clamp",
            "of": {
              "kind": "floor-div",
              "of": { "kind": "ref", "ref": "handCount", "of": "self" },
              "by": { "kind": "const", "value": 2 }
            },
            "min": 1,
            "max": 4
          }
        }
      ]
    }
  ]
}
