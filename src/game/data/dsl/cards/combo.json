{
  "$schema": "../schema.json",
  "dslVersion": 1,
  "kind": "card",
  "id": "combo",
  "priority": 100,
  "name": "连击",
  "short": "令对方获得 2 点威胁",
  "text": "消耗 1 点能量：令对方获得 2 点威胁。",
  "cost": { "kind": "const", "value": 1 },
  "rarity": "common",
  "use": [
    {
      "context": "play",
      "target": { "scope": "opponent", "required": false, "alive": true, "range": true },
      "effects": [
        {
          "kind": "move-cards",
          "from": { "zone": "hand", "of": "self" },
          "to": { "zone": "discard", "of": "self" },
          "pick": { "mode": "played" }
        },
        { "kind": "record-card-use", "of": "self", "cardKind": "combo" },
        { "kind": "log", "template": "{self} 对 {target} 使用{usedAs}{self.energyTag}" },
        { "kind": "threat", "target": "target", "amount": { "kind": "const", "value": 2 } }
      ]
    }
  ]
}
