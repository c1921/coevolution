{
  "$schema": "../schema.json",
  "dslVersion": 1,
  "kind": "card",
  "id": "sprint",
  "priority": 100,
  "name": "疾跑",
  "short": "本回合额外进行一次摸牌阶段",
  "text": "消耗 1 点能量：本回合立即额外进行一次摸牌阶段。",
  "cost": { "kind": "const", "value": 1 },
  "rarity": "uncommon",
  "use": [
    {
      "context": "play",
      "effects": [
        {
          "kind": "move-cards",
          "from": { "zone": "hand", "of": "self" },
          "to": { "zone": "discard", "of": "self" },
          "pick": { "mode": "played" }
        },
        { "kind": "extra-phase", "phase": "draw", "position": "next" },
        { "kind": "log", "template": "{self} 使用{usedAs}，本回合额外进行一次摸牌阶段{self.energyTag}" }
      ]
    }
  ]
}
