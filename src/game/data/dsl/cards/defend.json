{
  "$schema": "../schema.json",
  "dslVersion": 1,
  "kind": "card",
  "id": "defend",
  "priority": 20,
  "name": "防御",
  "short": "抵消一次【打击】",
  "text": "消耗 1 点能量：抵消一次【打击】。只能在响应时打出。",
  "cost": { "kind": "const", "value": 1 },
  "play": {
    "respondsTo": "strike",
    "effects": [
      {
        "kind": "move-cards",
        "from": { "zone": "hand", "of": "self" },
        "to": { "zone": "processing", "of": "self" },
        "pick": { "mode": "played" }
      },
      { "kind": "contest-contribute", "amount": { "kind": "const", "value": 1 } },
      {
        "kind": "if",
        "condition": { "kind": "card-transformed" },
        "then": [
          {
            "kind": "log",
            "template": "{self} 发动【{via}】，将{usedRaw}当{usedAs}打出{self.energyTag}"
          }
        ],
        "else": [{ "kind": "log", "template": "{self} 打出{usedAs}{self.energyTag}" }]
      }
    ]
  }
}
