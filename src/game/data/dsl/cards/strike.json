{
  "$schema": "../schema.json",
  "dslVersion": 1,
  "kind": "card",
  "id": "strike",
  "priority": 10,
  "name": "打击",
  "short": "令对方获得 1 点威胁",
  "text": "消耗 1 点能量：令对方获得 1 点威胁。对方可在自己的出牌阶段打出【防御】抵消；其回合结束时，剩余威胁结算为等量伤害。",
  "cost": { "kind": "const", "value": 1 },
  "use": [
    {
      "context": "play",
      "target": { "scope": "opponent", "required": false, "alive": true, "range": true },
      "effects": [
        {
          "kind": "move-cards",
          "from": { "zone": "hand", "of": "self" },
          "to": { "zone": "discard", "of": "self" },
          "pick": { "mode": "played" }
        },
        { "kind": "record-card-use", "of": "self", "cardKind": "strike" },
        {
          "kind": "if",
          "condition": { "kind": "card-transformed" },
          "then": [
            {
              "kind": "log",
              "template": "{self} 发动【{via}】，将{usedRaw}当{usedAs}对 {target} 使用{self.energyTag}"
            }
          ],
          "else": [
            { "kind": "log", "template": "{self} 对 {target} 使用{usedAs}{self.energyTag}" }
          ]
        },
        {
          "kind": "threat",
          "target": "target",
          "amount": { "kind": "channel", "channel": "threat-per-attack", "of": "self" }
        }
      ]
    }
  ]
}
