{
  "$schema": "../schema.json",
  "dslVersion": 1,
  "kind": "card",
  "id": "heal-plus",
  "priority": 110,
  "name": "回复+",
  "short": "回复 2 点体力",
  "text": "消耗 2 点能量：回复 2 点体力。出牌阶段只能对自己使用且需已受伤；濒死时可用来自救。",
  "cost": { "kind": "const", "value": 2 },
  "use": [
    {
      "context": "play",
      "target": { "scope": "self", "required": false, "alive": true },
      "requires": [
        {
          "kind": "compare",
          "op": "lt",
          "left": { "kind": "ref", "ref": "hp", "of": "self" },
          "right": { "kind": "ref", "ref": "maxHp", "of": "self" },
          "reason": "你的体力已满，无法使用【回复+】"
        }
      ],
      "effects": [
        {
          "kind": "move-cards",
          "from": { "zone": "hand", "of": "self" },
          "to": { "zone": "discard", "of": "self" },
          "pick": { "mode": "played" }
        },
        { "kind": "heal", "target": "self", "amount": { "kind": "const", "value": 2 } },
        { "kind": "log", "template": "{self} 使用{usedAs}，体力回复至 {self.hp}/{self.maxHp}{self.energyTag}" }
      ]
    },
    {
      "context": "dying",
      "target": { "scope": "dying", "required": true, "alive": true },
      "effects": [
        {
          "kind": "move-cards",
          "from": { "zone": "hand", "of": "self" },
          "to": { "zone": "discard", "of": "self" },
          "pick": { "mode": "played" }
        },
        { "kind": "heal", "target": "target", "amount": { "kind": "const", "value": 2 } },
        { "kind": "log", "template": "{self} 使用{usedAs}救援 {target}（体力 {target.hp}/{target.maxHp}）{self.energyTag}" },
        { "kind": "resolve-dying", "of": "target" }
      ]
    }
  ]
}
