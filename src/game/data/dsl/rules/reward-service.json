{
  "$schema": "../schema.json",
  "dslVersion": 1,
  "kind": "rule",
  "id": "reward-service",
  "priority": 20,
  "on": {
    "at": "turn-start"
  },
  "when": [
    {
      "kind": "compare",
      "op": "eq",
      "left": {
        "kind": "mul",
        "of": [
          {
            "kind": "floor-div",
            "of": {
              "kind": "ref",
              "ref": "turn"
            },
            "by": {
              "kind": "const",
              "value": 4
            }
          },
          {
            "kind": "const",
            "value": 4
          }
        ]
      },
      "right": {
        "kind": "ref",
        "ref": "turn"
      }
    }
  ],
  "effects": [
    {
      "kind": "offer-reward",
      "reward": "service",
      "healAmount": {
        "kind": "const",
        "value": 1
      },
      "removeFloor": 5
    }
  ]
}
