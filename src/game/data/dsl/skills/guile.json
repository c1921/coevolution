{
  "$schema": "../schema.json",
  "dslVersion": 1,
  "kind": "skill",
  "id": "guile",
  "priority": 80,
  "name": "狡计",
  "text": "当你受到伤害后，你可以获得伤害来源的一张手牌。",
  "trigger": {
    "on": { "at": "after-damage" },
    "optional": true,
    "when": [
      {
        "kind": "has-cards",
        "of": "source",
        "zone": "hand",
        "atLeast": { "kind": "const", "value": 1 }
      }
    ],
    "effects": [
      {
        "kind": "move-cards",
        "from": { "zone": "hand", "of": "source" },
        "to": { "zone": "hand", "of": "self" },
        "pick": { "mode": "random", "count": 1 }
      },
      {
        "kind": "if",
        "condition": { "kind": "picked-count", "atLeast": { "kind": "const", "value": 1 } },
        "then": [
          { "kind": "log", "template": "{self} 发动【狡计】，获得 {source} 的一张手牌" }
        ],
        "else": [{ "kind": "log", "template": "{self} 发动【狡计】，但对方没有手牌" }]
      }
    ]
  }
}
