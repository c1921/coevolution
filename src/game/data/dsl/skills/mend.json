{
  "$schema": "../schema.json",
  "dslVersion": 1,
  "kind": "skill",
  "id": "mend",
  "priority": 60,
  "name": "疗愈",
  "text": "出牌阶段限一次，你可以弃置一张手牌，令一名已受伤的角色回复 1 点体力。",
  "activate": {
    "timing": "play",
    "oncePerTurn": true,
    "costCards": { "count": { "kind": "const", "value": 1 } },
    "target": {
      "scope": "any",
      "required": false,
      "default": "self",
      "alive": true,
      "conditions": [
        {
          "kind": "compare",
          "op": "lt",
          "left": { "kind": "ref", "ref": "hp", "of": "target" },
          "right": { "kind": "ref", "ref": "maxHp", "of": "target" }
        }
      ]
    },
    "effects": [
      {
        "kind": "move-cards",
        "from": { "zone": "hand", "of": "self" },
        "to": { "zone": "discard", "of": "self" },
        "pick": { "mode": "cost" }
      },
      { "kind": "record-skill-use", "skill": "mend" },
      { "kind": "heal", "target": "target", "amount": { "kind": "const", "value": 1 } },
      {
        "kind": "log",
        "template": "{self} 发动【疗愈】，弃置{cost}，令 {target} 回复 1 点体力（体力 {target.hp}/{target.maxHp}）"
      }
    ],
    "ui": { "buttonLabel": "发动【疗愈】（先点选一张手牌）" }
  }
}
