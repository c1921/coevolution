{
  "$schema": "../schema.json",
  "dslVersion": 1,
  "kind": "skill",
  "id": "snatch",
  "priority": 40,
  "name": "夺食",
  "text": "当你受到伤害后，你可以获得造成此伤害的牌。",
  "trigger": {
    "on": { "at": "after-damage" },
    "optional": true,
    "when": [{ "kind": "in-processing", "card": "event-card" }],
    "effects": [
      {
        "kind": "move-cards",
        "from": { "zone": "processing", "of": "self" },
        "to": { "zone": "hand", "of": "self" },
        "pick": { "mode": "specific", "card": "event-card" }
      },
      {
        "kind": "if",
        "condition": { "kind": "picked-count", "atLeast": { "kind": "const", "value": 1 } },
        "then": [{ "kind": "log", "template": "{self} 发动【夺食】，获得{picked}" }],
        "else": [{ "kind": "log", "template": "{self} 发动【夺食】，但该牌已不在处理区" }]
      }
    ]
  }
}
